# Application Settings
APP_NAME=InsightAI - AI-Powered Data Analyst
API_PREFIX=/api
SECRET_KEY=change-this-to-a-secure-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Ollama AI Configuration (Runs locally on your PC)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional MongoDB Connection (SQLite is used by default)
MONGODB_URI=
MONGODB_DATABASE=insightai
MONGODB_USERS_COLLECTION=users
ALLOW_MONGO_FALLBACK=true

# Password Reset OTP (Optional SMTP Email Settings)
OTP_EXPIRE_MINUTES=10
EXPOSE_OTP_IN_RESPONSE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
RESEND_API_KEY=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173
